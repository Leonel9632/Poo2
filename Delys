		double calcularTarifa(double distanciaKm) const
		{
			return TARIFA_BASE + distanciaKm * TARIFA_POR_KM;
		}
		
		int buscarRepartidorMasCercano(const Ubicacion& destino) const
		{
			int mejor = -1;
			double menorDistancia = 0.0;
			for (int i = 0; i < cantidadRepartidores; i++)
			{
				if (!repartidores[i].estaDisponible())
				{
					continue;
				}
				double d = repartidores[i].getUbicacion().distanciaA(destino);
				if (mejor == -1 || d < menorDistancia)
				{
					menorDistancia = d;
					mejor = i;
				}
			}
			return mejor;
		}
		
		bool confirmarOrden(Orden orden)
		{
			if (cantidadOrdenes >= MAX_ORDENES)
			{
				cout << "\nSe alcanzo el limite de ordenes.\n";
				return false;
			}
			int ic = buscarCliente(orden.getIdCliente());
			int it = buscarTienda(orden.getIdTienda());
			if (ic == -1 || it == -1)
			{
				cout << "\nCliente o tienda no valido.\n";
				return false;
			}
			if (orden.getCantidadItems() == 0)
			{
				cout << "\nLa orden no tiene productos.\n";
				return false;
			}
			
			int ir = buscarRepartidorMasCercano(tiendas[it].getUbicacion());
			if (ir == -1)
			{
				cout << "\nNo hay repartidores disponibles en este momento.\n";
				return false;
			}
			double distanciaRepartidor =
				repartidores[ir].getUbicacion().distanciaA(tiendas[it].getUbicacion());
			
			double distancia = tiendas[it].getUbicacion().distanciaA(clientes[ic].getUbicacion());
			double tarifa = calcularTarifa(distancia);
			
			orden.asignarEnvio(repartidores[ir].getIdRepartidor(), distancia, tarifa);
			
			if (!saveItem.saveOrden(orden))
			{
				return false;
			}
			repartidores[ir].setDisponible(false);
			ordenes[cantidadOrdenes] = orden;
			cantidadOrdenes++;
			
			saveItem.reescribirRepartidores(repartidores, cantidadRepartidores);
			saveItem.saveTransaccion(describirOrden(orden, "Creada"));
			
			cout << "\nOrden creada correctamente.\n";
			cout << "Repartidor asignado: " << repartidores[ir].getNombre()
				<< " (a " << formatear(distanciaRepartidor) << " km de la tienda)\n\n";
			orden.mostrar(
						  clientes[ic].getNombre(),
						  tiendas[it].getNombre(),
						  repartidores[ir].getNombre()
						  );
			return true;
		}
		
		bool avanzarEstadoOrden(int idOrden)
		{
			int io = buscarOrden(idOrden);
			if (io == -1)
			{
				cout << "\nNo existe la orden con el ID " << idOrden << ".\n";
				return false;
			}
			string anterior = ordenes[io].getEstado();
			if (!ordenes[io].avanzarEstado())
			{
				cout << "\nLa orden " << idOrden << " ya fue entregada.\n";
				return false;
			}
			string nuevo = ordenes[io].getEstado();
			
			if (nuevo == "Entregado")
			{
				int ir = buscarRepartidor(ordenes[io].getIdRepartidor());
				int ic = buscarCliente(ordenes[io].getIdCliente());
				if (ir != -1)
				{
					if (ic != -1)
					{
						repartidores[ir].setUbicacion(clientes[ic].getUbicacion());
					}
					repartidores[ir].setDisponible(true);
					saveItem.reescribirRepartidores(repartidores, cantidadRepartidores);
				}
			}
			saveItem.reescribirOrdenes(ordenes, cantidadOrdenes);
			saveItem.saveTransaccion(
									 describirOrden(ordenes[io], "Estado: " + anterior + " -> " + nuevo)
									 );
			
			cout << "\nOrden " << idOrden << ": " << anterior << " -> " << nuevo << '\n';
			ordenes[io].mostrarProgreso();
			if (nuevo == "Entregado")
			{
				cout << "El repartidor " << nombreRepartidor(ordenes[io].getIdRepartidor())
					<< " queda disponible nuevamente.\n";
			}
			return true;
		}
		
