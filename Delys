				ordenes[cantidad] = Orden::fromString(linea);
				cantidad++;
			}
			catch (...)
			{
				cout << "\nRegistro de orden incorrecto: " << linea << '\n';
			}
		}
		archivo.close();
		return cantidad;
	}
	
	void mostrarHistorial() const
	{
		ifstream archivo("transacciones.txt");
		if (!archivo.is_open())
		{
			cout << "\nAun no hay transacciones registradas.\n";
			return;
		}
		cout << "\n=========== HISTORIAL DE TRANSACCIONES ===========\n";
		string linea;
		int total = 0;
		while (getline(archivo, linea))
		{
			if (!linea.empty())
			{
				cout << linea << '\n';
				total++;
			}
		}
		archivo.close();
		if (total == 0)
		{
			cout << "Aun no hay transacciones registradas.\n";
		}
	}
};

class Gestion
{
private:
	Tienda tiendas[MAX_TIENDAS];
