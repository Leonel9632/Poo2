		bool agregarTienda(int idTienda, const string& nombre,
						   double latitud, double longitud)
		{
			if (idTienda <= 0)
			{
				cout << "\nEl ID debe ser mayor que cero.\n";
				return false;
			}
			if (cantidadTiendas >= MAX_TIENDAS)
			{
				cout << "\nSe alcanzo el limite de tiendas.\n";
				return false;
			}
			if (buscarTienda(idTienda) != -1)
			{
				cout << "\nYa existe una tienda con el ID " << idTienda << ".\n";
				return false;
			}
			if (!coordenadasValidas(latitud, longitud))
			{
				return false;
			}
			Tienda tienda(idTienda, nombre, Ubicacion(latitud, longitud));
			if (!saveItem.saveTienda(tienda))
			{
				return false;
			}
			tiendas[cantidadTiendas] = tienda;
			cantidadTiendas++;
			return true;
		}
		bool agregarProducto(int idProducto, int idTienda,
							 const string& nombre, double precio)
		{
			if (idProducto <= 0)
			{
				cout << "\nEl ID debe ser mayor que cero.\n";
				return false;
			}
			if (cantidadProductos >= MAX_PRODUCTOS)
			{
