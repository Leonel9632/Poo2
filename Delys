		}
		gestion.mostrarClientes();
		int idCliente = leerEntero("ID del cliente: ");
		if (gestion.buscarCliente(idCliente) == -1)
		{
			cout << "\nNo existe el cliente con el ID " << idCliente << ".\n";
			return;
		}
		gestion.mostrarTiendas();
		int idTienda = leerEntero("ID de la tienda: ");
		if (gestion.buscarTienda(idTienda) == -1)
		{
			cout << "\nNo existe la tienda con el ID " << idTienda << ".\n";
			return;
		}
		if (gestion.contarProductosTienda(idTienda) == 0)
		{
			cout << "\nEsta tienda no tiene productos disponibles.\n";
			return;
		}
		
		Orden orden(gestion.siguienteIdOrden(), idCliente, idTienda);
		
		while (true)
		{
			gestion.mostrarMenuTienda(idTienda);
			int idProducto = leerEntero("\nID del producto a agregar (0 para terminar): ");
			if (idProducto == 0)
			{
				break;
			}
			int indice = gestion.buscarProductoDeTienda(idProducto, idTienda);
			if (indice == -1)
			{
				cout << "\nProducto no disponible en esta tienda.\n";
				continue;
			}
			int cantidad = leerEntero("Cantidad: ");
			if (cantidad <= 0)
			{
				cout << "\nLa cantidad debe ser mayor que cero.\n";
				continue;
			}
			const Producto& producto = gestion.getProducto(indice);
			ItemOrden item(producto.getNombre(), cantidad, producto.getPrecio());
			if (orden.agregarItem(item))
			{
				cout << "\nAgregado al carrito. Subtotal actual: S/ "
					<< formatear(orden.getSubtotal()) << '\n';
			}
			else
			{
				cout << "\nEl carrito esta lleno (maximo " << MAX_ITEMS << " productos).\n";
				break;
			}
		}
		
		if (orden.getCantidadItems() == 0)
		{
			cout << "\nLa orden esta vacia. Orden cancelada.\n";
			return;
		}
		gestion.confirmarOrden(orden);
	}
