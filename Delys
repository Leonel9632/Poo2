				return false;
			}
			if (precio <= 0)
			{
				cout << "\nEl precio debe ser mayor que cero.\n";
				return false;
			}
			Producto producto(idProducto, idTienda, nombre, precio, true);
			if (!saveItem.saveProducto(producto))
			{
				return false;
			}
			productos[cantidadProductos] = producto;
			cantidadProductos++;
			return true;
