		bool agregarCliente(int idCliente, const string& nombre,
							const string& telefono,
							double latitud, double longitud)
		{
			if (idCliente <= 0)
			{
				cout << "\nEl ID debe ser mayor que cero.\n";
				return false;
			}
			if (cantidadClientes >= MAX_CLIENTES)
			{
				cout << "\nSe alcanzo el limite de clientes.\n";
				return false;
			}
			if (buscarCliente(idCliente) != -1)
