				if (productos[i].getIdTienda() == idTienda &&
					productos[i].estaDisponible())
				{
					productos[i].mostrar();
					mostrados++;
				}
			}
			if (mostrados == 0)
			{
				cout << "Esta tienda no tiene productos disponibles.\n";
			}
		}
