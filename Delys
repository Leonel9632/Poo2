	bool coordenadasValidas(double latitud, double longitud) const
	{
		if (latitud < -90.0 || latitud > 90.0 ||
			longitud < -180.0 || longitud > 180.0)
		{
			cout << "\nCoordenadas fuera de rango (latitud -90 a 90, longitud -180 a 180).\n";
			return false;
		}
		return true;
	}
	string describirOrden(const Orden& orden, const string& evento) const
	{
		return "Orden " + to_string(orden.getIdOrden()) +
			" | " + evento +
			" | Cliente: " + nombreCliente(orden.getIdCliente()) +
			" | Tienda: " + nombreTienda(orden.getIdTienda()) +
			" | Repartidor: " + nombreRepartidor(orden.getIdRepartidor()) +
			" | Distancia: " + formatear(orden.getDistancia()) + " km" +
			" | Tarifa: S/ " + formatear(orden.getTarifa()) +
			" | Total: S/ " + formatear(orden.getTotal()) +
			" | Estado: " + orden.getEstado();
	}
public:
		Gestion()
		{
			cantidadTiendas = loadItem.loadTiendas(tiendas, MAX_TIENDAS);
			cantidadProductos = loadItem.loadProductos(productos, MAX_PRODUCTOS);
			cantidadClientes = loadItem.loadClientes(clientes, MAX_CLIENTES);
			cantidadRepartidores = loadItem.loadRepartidores(repartidores, MAX_REPARTIDORES);
			cantidadOrdenes = loadItem.loadOrdenes(ordenes, MAX_ORDENES);
		}
		
		int buscarTienda(int idTienda) const
