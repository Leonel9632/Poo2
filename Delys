class Menu
{
private:
	Gestion gestion;
	
	int leerEntero(const string& mensaje)
	{
		string texto;
		while (true)
		{
			cout << mensaje;
			if (!getline(cin, texto))
			{
				return 0;
			}
			try
			{
				size_t posicion = 0;
				int valor = stoi(texto, &posicion);
				if (posicion == texto.size())
				{
					return valor;
				}
			}
			catch (...)
			{
			}
			cout << "Entrada incorrecta. Ingrese un numero entero.\n";
		}
	}
	
	double leerDecimal(const string& mensaje)
	{
		string texto;
		while (true)
		{
			cout << mensaje;
			if (!getline(cin, texto))
			{
				return 0.0;
			}
			try
			{
				size_t posicion = 0;
				double valor = stod(texto, &posicion);
				if (posicion == texto.size())
				{
					return valor;
				}
			}
			catch (...)
			{
			}
			cout << "Entrada incorrecta. Ingrese un numero (use punto decimal).\n";
		}
	}
