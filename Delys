			valido = true;
			if (texto.empty())
			{
				cout << "El texto no puede estar vacio.\n";
				valido = false;
			}
			else if (texto.find('|') != string::npos ||
					 texto.find(':') != string::npos ||
					 texto.find(';') != string::npos)
			{
				cout << "No se permiten los caracteres | : ;\n";
