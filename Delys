class Orden
{
private:
	int idOrden;
	int idCliente;
	int idTienda;
	int idRepartidor;
	string estado;
	double distancia;
	double tarifa;
	double subtotal;
	ItemOrden items[MAX_ITEMS];
	int cantidadItems;
public:
	Orden()
	{
		idOrden = 0;
		idCliente = 0;
		idTienda = 0;
		idRepartidor = 0;
		estado = "Pendiente";
		distancia = 0.0;
		tarifa = 0.0;
		subtotal = 0.0;
		cantidadItems = 0;
	}
	Orden(int idOrden, int idCliente, int idTienda)
	{
		this->idOrden = idOrden;
		this->idCliente = idCliente;
		this->idTienda = idTienda;
		idRepartidor = 0;
		estado = "Pendiente";
		distancia = 0.0;
		tarifa = 0.0;
		subtotal = 0.0;
		cantidadItems = 0;
	}
	int getIdOrden() const
	{
		return idOrden;
	}
	int getIdCliente() const
	{
		return idCliente;
	}
	int getIdTienda() const
	{
		return idTienda;
	}
	int getIdRepartidor() const
	{
		return idRepartidor;
	}
	const string& getEstado() const
	{
		return estado;
	}
	double getDistancia() const
	{
		return distancia;
	}
	double getTarifa() const
	{
		return tarifa;
	}
	double getSubtotal() const
	{
		return subtotal;
	}
	double getTotal() const
	{
		return subtotal + tarifa;
	}
	int getCantidadItems() const
	{
		return cantidadItems;
	}
	bool agregarItem(const ItemOrden& item)
	{
		if (cantidadItems >= MAX_ITEMS)
		{
			return false;
		}
		items[cantidadItems] = item;
		cantidadItems++;
		subtotal += item.subtotal();
		return true;
	}
	void asignarEnvio(int idRepartidor, double distancia, double tarifa)
	{
		this->idRepartidor = idRepartidor;
		this->distancia = distancia;
		this->tarifa = tarifa;
	}
	
	bool avanzarEstado()
	{
		if (estado == "Pendiente")
		{
			estado = "Preparando";
		}
		else if (estado == "Preparando")
		{
			estado = "En camino";
		}
		else if (estado == "En camino")
		{
			estado = "Entregado";
		}
		else
		{
			return false;
		}
		return true;
	}
	void mostrarProgreso() const
	{
		const string fases[4] = {"Pendiente", "Preparando", "En camino", "Entregado"};
		cout << "Ciclo: ";
		for (int i = 0; i < 4; i++)
		{
			if (fases[i] == estado)
			{
				cout << "[" << fases[i] << "]";
			}
			else
			{
				cout << fases[i];
			}
			if (i < 3)
			{
				cout << " -> ";
			}
		}
		cout << '\n';
	}
	void mostrar(const string& cliente, const string& tienda,
				 const string& repartidor) const
	{
		cout << "Orden: " << idOrden << '\n';
		cout << "Cliente: " << cliente << '\n';
		cout << "Tienda: " << tienda << '\n';
		cout << "Repartidor: " << repartidor << '\n';
		cout << "Productos:\n";
		for (int i = 0; i < cantidadItems; i++)
		{
			cout << "  ";
			items[i].mostrar();
		}
		cout << "Subtotal: S/ " << formatear(subtotal) << '\n';
		cout << "Distancia: " << formatear(distancia) << " km\n";
		cout << "Tarifa de entrega: S/ " << formatear(tarifa) << '\n';
		cout << "Total: S/ " << formatear(getTotal()) << '\n';
		cout << "Estado: " << estado << '\n';
		mostrarProgreso();
	}
	string toString() const
	{
		string textoItems = "";
		for (int i = 0; i < cantidadItems; i++)
		{
			if (i > 0)
			{
				textoItems += ";";
			}
			textoItems += items[i].toString();
		}
		return to_string(idOrden) + "|" +
			to_string(idCliente) + "|" +
			to_string(idTienda) + "|" +
			to_string(idRepartidor) + "|" +
			estado + "|" +
			to_string(distancia) + "|" +
			to_string(tarifa) + "|" +
			to_string(subtotal) + "|" +
			textoItems;
	}
	static Orden fromString(const string& registro)
	{
		Orden orden(
					stoi(obtenerCampo(registro, 0, '|')),
					stoi(obtenerCampo(registro, 1, '|')),
					stoi(obtenerCampo(registro, 2, '|'))
					);
		orden.idRepartidor = stoi(obtenerCampo(registro, 3, '|'));
		orden.estado = obtenerCampo(registro, 4, '|');
		orden.distancia = stod(obtenerCampo(registro, 5, '|'));
		orden.tarifa = stod(obtenerCampo(registro, 6, '|'));
		orden.subtotal = stod(obtenerCampo(registro, 7, '|'));
		
		string textoItems = obtenerCampo(registro, 8, '|');
		int i = 0;
		while (orden.cantidadItems < MAX_ITEMS)
		{
			string textoItem = obtenerCampo(textoItems, i, ';');
			if (textoItem.empty())
			{
				break;
			}
			orden.items[orden.cantidadItems] = ItemOrden::fromString(textoItem);
			orden.cantidadItems++;
			i++;
		}
		return orden;
	}
};

class SaveItem
{
private:
	bool agregar(const string& nombreArchivo, const string& registro) const
	{
		ofstream archivo(nombreArchivo, ios::app);
		if (!archivo.is_open())
		{
			cout << "\nNo se pudo abrir el archivo: " << nombreArchivo << '\n';
			return false;
		}
		archivo << registro << '\n';
		archivo.close();
		return true;
	}
public:
		bool saveTienda(const Tienda& tienda) const
		{
			return agregar("tiendas.txt", tienda.toString());
		}
		bool saveProducto(const Producto& producto) const
		{
			return agregar("productos.txt", producto.toString());
		}
		bool saveCliente(const Cliente& cliente) const
		{
			return agregar("clientes.txt", cliente.toString());
		}
		bool saveRepartidor(const Repartidor& repartidor) const
		{
			return agregar("repartidores.txt", repartidor.toString());
		}
		bool saveOrden(const Orden& orden) const
		{
			return agregar("ordenes.txt", orden.toString());
		}
		bool saveTransaccion(const string& texto) const
		{
			return agregar("transacciones.txt", texto);
		}
		
		bool reescribirRepartidores(const Repartidor repartidores[], int cantidad) const
		{
			ofstream archivo("repartidores.txt", ios::trunc);
			if (!archivo.is_open())
			{
				cout << "\nNo se pudo abrir el archivo: repartidores.txt\n";
				return false;
			}
			for (int i = 0; i < cantidad; i++)
			{
				archivo << repartidores[i].toString() << '\n';
			}
			archivo.close();
			return true;
		}
		bool reescribirOrdenes(const Orden ordenes[], int cantidad) const
		{
			ofstream archivo("ordenes.txt", ios::trunc);
			if (!archivo.is_open())
			{
				cout << "\nNo se pudo abrir el archivo: ordenes.txt\n";
				return false;
			}
			for (int i = 0; i < cantidad; i++)
			{
				archivo << ordenes[i].toString() << '\n';
			}
			archivo.close();
			return true;
		}
};

