string obtenerCampo(const string& registro, int numero, char separador)
{
	int actual = 0;
	string campo = "";
	for (size_t i = 0; i < registro.size(); i++)
	{
		if (registro[i] == separador)
		{
			if (actual == numero)
			{
				return campo;
			}
			actual++;
			campo = "";
		}
		else
		{
			campo += registro[i];
		}
	}
	if (actual == numero)
	{
		return campo;
	}
	return "";
}

string formatear(double valor)
{
	double redondeado = round(valor * 100.0) / 100.0;
	string texto = to_string(redondeado);
	size_t punto = texto.find('.');
	if (punto == string::npos)
	{
		return texto;
	}
	return texto.substr(0, punto + 3);
}

class Ubicacion
{
private:
	double latitud;
	double longitud;
public:
	Ubicacion()
	{
		latitud = 0.0;
		longitud = 0.0;
	}
	Ubicacion(double latitud, double longitud)
	{
		this->latitud = latitud;
		this->longitud = longitud;
	}
	
	double distanciaA(const Ubicacion& otra) const
	{
		const double RADIO_TIERRA = 6371.0;
		const double PI = 3.14;
		double lat1 = latitud * PI / 180.0;
		double lat2 = otra.latitud * PI / 180.0;
		double dLat = (otra.latitud - latitud) * PI / 180.0;
		double dLon = (otra.longitud - longitud) * PI / 180.0;
		double a = sin(dLat / 2.0) * sin(dLat / 2.0) +
			cos(lat1) * cos(lat2) *
			sin(dLon / 2.0) * sin(dLon / 2.0);
		double c = 2.0 * atan2(sqrt(a), sqrt(1.0 - a));
		return RADIO_TIERRA * c;
	}
	void mostrar() const
	{
		cout << "Ubicacion GPS: (" << to_string(latitud)
			<< ", " << to_string(longitud) << ")\n";
	}
	string toString() const
	{
		return to_string(latitud) + "|" + to_string(longitud);
	}
};

